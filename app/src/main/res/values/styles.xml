<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cyber Card Style -->
    <style name="Widget.SwiftKeyWhisper.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cyber_surface</item>
        <item name="strokeColor">@color/cyber_surface_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Cyber Outlined TextInputLayout -->
    <style name="Widget.SwiftKeyWhisper.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/cyber_surface_border</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="hintTextColor">@color/neon_cyan</item>
        <item name="android:textColorHint">@color/cyber_text_muted</item>
    </style>

    <!-- Cyber Chip Style -->
    <style name="Widget.SwiftKeyWhisper.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/cyber_surface_elevated</item>
        <item name="chipStrokeColor">@color/cyber_surface_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="android:textColor">@color/cyber_text_secondary</item>
        <item name="rippleColor">@color/neon_cyan_glow</item>
    </style>
</resources>
